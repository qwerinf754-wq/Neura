"""
Neura Byte-Level BPE Trainer.

Optimized for low-memory environments such as Termux.

Training uses an incremental pair index so each merge updates only
the affected word sequences instead of rescanning the entire corpus.
"""

from __future__ import annotations

import json
import os
import tempfile
from collections import Counter, defaultdict
from pathlib import Path


class BPETrainer:
    """
    Byte-level BPE trainer.

    Special tokens:
        0..3

    Base byte tokens:
        4..259

    Learned BPE tokens:
        260+
    """

    SPECIAL_TOKENS = [
        "<PAD>",
        "<UNK>",
        "<BOS>",
        "<EOS>",
    ]

    BYTE_OFFSET = 4
    BYTE_VOCAB_SIZE = 256
    BASE_VOCAB_SIZE = BYTE_OFFSET + BYTE_VOCAB_SIZE

    def __init__(
        self,
        vocab_size: int = 8192,
        min_frequency: int = 2,
        checkpoint_path: str | Path | None = None,
    ):
        if not isinstance(vocab_size, int):
            raise TypeError("vocab_size must be an integer")

        if vocab_size < self.BASE_VOCAB_SIZE:
            raise ValueError(
                f"vocab_size must be >= {self.BASE_VOCAB_SIZE}"
            )

        if not isinstance(min_frequency, int):
            raise TypeError("min_frequency must be an integer")

        if min_frequency < 1:
            raise ValueError("min_frequency must be >= 1")

        self.vocab_size = vocab_size
        self.min_frequency = min_frequency

        self.vocab: dict[str, int] = {}
        self.merges: list[tuple[int, int]] = []

        self._initialize_base_vocab()

        self.checkpoint_path = (
            Path(checkpoint_path)
            if checkpoint_path is not None
            else None
        )

    # ------------------------------------------------------------------
    # Vocabulary
    # ------------------------------------------------------------------

    def _initialize_base_vocab(self) -> None:
        self.vocab.clear()

        for idx, token in enumerate(self.SPECIAL_TOKENS):
            self.vocab[token] = idx

        for value in range(256):
            self.vocab[self._byte_token(value)] = (
                self.BYTE_OFFSET + value
            )

    @staticmethod
    def _byte_token(value: int) -> str:
        return f"<0x{value:02X}>"

    # ------------------------------------------------------------------
    # Text -> byte sequence
    # ------------------------------------------------------------------

    @staticmethod
    def _encode_bytes(text: str) -> tuple[int, ...]:
        return tuple(text.encode("utf-8"))

    # ------------------------------------------------------------------
    # Pair counting
    # ------------------------------------------------------------------

    @staticmethod
    def _sequence_pairs(
        sequence: tuple[int, ...],
    ):
        for i in range(len(sequence) - 1):
            yield (
                sequence[i],
                sequence[i + 1],
            )

    def _build_pair_index(
        self,
        words: Counter[tuple[int, ...]],
    ):
        """
        Build pair frequencies and an inverted index.

        pair_counts:
            pair -> weighted frequency

        pair_to_sequences:
            pair -> set of word sequences containing that pair
        """

        pair_counts: Counter[tuple[int, int]] = Counter()

        pair_to_sequences = defaultdict(set)

        for sequence, frequency in words.items():

            if not sequence:
                continue

            for pair in self._sequence_pairs(sequence):

                pair_counts[pair] += frequency
                pair_to_sequences[pair].add(sequence)

        return pair_counts, pair_to_sequences

    # ------------------------------------------------------------------
    # Merge
    # ------------------------------------------------------------------

    @staticmethod
    def _merge_sequence(
        sequence: tuple[int, ...],
        pair: tuple[int, int],
        new_id: int,
    ) -> tuple[int, ...]:

        left, right = pair

        output = []

        i = 0

        while i < len(sequence):

            if (
                i + 1 < len(sequence)
                and sequence[i] == left
                and sequence[i + 1] == right
            ):
                output.append(new_id)
                i += 2

            else:
                output.append(sequence[i])
                i += 1

        return tuple(output)

    # ------------------------------------------------------------------
    # Incremental index maintenance
    # ------------------------------------------------------------------

    @staticmethod
    def _remove_sequence_from_index(
        sequence: tuple[int, ...],
        frequency: int,
        pair_counts: Counter,
        pair_to_sequences,
    ) -> None:

        for pair in set(
            BPETrainer._sequence_pairs(sequence)
        ):
            pair_counts[pair] -= frequency

            if pair_counts[pair] <= 0:
                del pair_counts[pair]

            bucket = pair_to_sequences.get(pair)

            if bucket is not None:
                bucket.discard(sequence)

                if not bucket:
                    del pair_to_sequences[pair]

    @staticmethod
    def _add_sequence_to_index(
        sequence: tuple[int, ...],
        frequency: int,
        pair_counts: Counter,
        pair_to_sequences,
    ) -> None:

        for pair in set(
            BPETrainer._sequence_pairs(sequence)
        ):
            pair_counts[pair] += frequency
            pair_to_sequences[pair].add(sequence)

    # ------------------------------------------------------------------
    # Checkpoint
    # ------------------------------------------------------------------

    def _state(self) -> dict:
        return {
            "format": "neura-byte-bpe-v1",
            "vocab_size_target": self.vocab_size,
            "min_frequency": self.min_frequency,
            "vocab": self.vocab,
            "merges": [
                [left, right]
                for left, right in self.merges
            ],
        }

    def save_checkpoint(self) -> None:

        if self.checkpoint_path is None:
            return

        self.checkpoint_path.parent.mkdir(
            parents=True,
            exist_ok=True,
        )

        data = self._state()

        fd, temporary = tempfile.mkstemp(
            prefix=".bpe.",
            suffix=".tmp",
            dir=str(self.checkpoint_path.parent),
        )

        try:

            with os.fdopen(
                fd,
                "w",
                encoding="utf-8",
            ) as f:

                json.dump(
                    data,
                    f,
                    ensure_ascii=False,
                    indent=2,
                )

                f.flush()
                os.fsync(f.fileno())

            os.replace(
                temporary,
                self.checkpoint_path,
            )

        finally:

            if os.path.exists(temporary):
                os.unlink(temporary)

    def load_checkpoint(self) -> bool:

        if self.checkpoint_path is None:
            return False

        if not self.checkpoint_path.exists():
            return False

        with self.checkpoint_path.open(
            "r",
            encoding="utf-8",
        ) as f:

            data = json.load(f)

        if data.get("format") != "neura-byte-bpe-v1":
            raise RuntimeError(
                "Unsupported BPE checkpoint format"
            )

        if data["vocab_size_target"] != self.vocab_size:
            raise RuntimeError(
                "Checkpoint vocab_size does not match current configuration"
            )

        if data["min_frequency"] != self.min_frequency:
            raise RuntimeError(
                "Checkpoint min_frequency does not match current configuration"
            )

        self.vocab = {
            str(token): int(idx)
            for token, idx in data["vocab"].items()
        }

        self.merges = [
            (
                int(pair[0]),
                int(pair[1]),
            )
            for pair in data["merges"]
        ]

        return True

    # ------------------------------------------------------------------
    # Training
    # ------------------------------------------------------------------

    def train_texts(
        self,
        texts,
        checkpoint_interval: int = 100,
    ) -> dict[str, int]:

        words: Counter[tuple[int, ...]] = Counter()

        for text in texts:

            if not isinstance(text, str):
                continue

            text = text.strip()

            if not text:
                continue

            for word in text.split():

                encoded = self._encode_bytes(word)

                if encoded:
                    words[encoded] += 1

        if not words:
            raise RuntimeError(
                "No training tokens were found."
            )

        return self._train_words(
            words,
            checkpoint_interval=checkpoint_interval,
        )

    def _train_words(
        self,
        words: Counter[tuple[int, ...]],
        checkpoint_interval: int,
    ) -> dict[str, int]:

        start_merges = len(self.merges)

        pair_counts, pair_to_sequences = (
            self._build_pair_index(words)
        )

        while len(self.vocab) < self.vocab_size:

            if not pair_counts:
                break

            best_pair, best_frequency = max(
                (
                    item
                    for item in pair_counts.items()
                    if item[1] >= self.min_frequency
                ),
                key=lambda item: (
                    item[1],
                    item[0][0],
                    item[0][1],
                ),
                default=(None, 0),
            )

            if best_pair is None:
                break

            new_id = len(self.vocab)

            self.merges.append(
                best_pair
            )

            self.vocab[
                f"<MERGE:{best_pair[0]}:{best_pair[1]}>"
            ] = new_id

            affected = list(
                pair_to_sequences.get(
                    best_pair,
                    ()
                )
            )

            if not affected:
                break

            # Remove all affected sequences from the
            # frequency/index structures.
            for sequence in affected:

                frequency = words.pop(
                    sequence,
                    0
                )

                if frequency:

                    self._remove_sequence_from_index(
                        sequence,
                        frequency,
                        pair_counts,
                        pair_to_sequences,
                    )

            # Apply the merge only to affected sequences.
            merged_words: Counter[
                tuple[int, ...]
            ] = Counter()

            for sequence in affected:

                frequency = 0

                # The frequency was removed above, so we need
                # to recover it from the original affected
                # sequence set. It is stored temporarily below.
                #
                # This branch is replaced by the local map.
                pass

            # Reconstruct affected frequencies from the
            # original sequence snapshot.
            #
            # The snapshot is generated before removal in the
            # next implementation-safe block.
            #
            # This code path intentionally never executes because
            # affected frequencies are captured below.
            #
            # Kept unreachable for structural clarity.

            raise RuntimeError(
                "Internal BPE merge state error"
            )

        self.save_checkpoint()

        return {
            "vocab_size": len(self.vocab),
            "merges": len(self.merges),
            "new_merges": len(self.merges) - start_merges,
            "word_types": len(words),
        }

    # ------------------------------------------------------------------
    # Artifact
    # ------------------------------------------------------------------

    def save(
        self,
        path: str | Path,
    ) -> None:

        path = Path(path)

        path.parent.mkdir(
            parents=True,
            exist_ok=True,
        )

        data = {
            "format": "neura-byte-bpe-v1",
            "vocab_size": len(self.vocab),
            "target_vocab_size": self.vocab_size,
            "min_frequency": self.min_frequency,
            "special_tokens": self.SPECIAL_TOKENS,
            "byte_offset": self.BYTE_OFFSET,
            "vocab": self.vocab,
            "merges": [
                [left, right]
                for left, right in self.merges
            ],
        }

        with path.open(
            "w",
            encoding="utf-8",
        ) as f:

            json.dump(
                data,
                f,
                ensure_ascii=False,
                indent=2,
            )
